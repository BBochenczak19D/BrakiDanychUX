  \item \code{\link{wrazliwosc_mnar}} i \code{\link{siatka_wrazliwosci}}
    zaweza granice przy jawnych zalozeniach o brakach,
  \item \code{\link{generuj_mnar}} tworzy dane o znanym efekcie.
}
}
